{
  "schemaVersion": 1,
  "id": "orangesunshine",
  "version": "${version}",
  "name": "orangesunshine",
  "description": "Adds drugs into Minecraft",
  "authors": [
    "moriz"
  ],
  "contact": {
    "homepage": "http://www.minecraftforum.net/topic/563257-152",
    "sources": "https://github.com/Sollace/orangesunshine",
    "issues": "https://github.com/Sollace/orangesunshine/issues"
  },
  "license": "MIT",
  "icon": "logo.png",
  "accessWidener": "orangesunshine.aw",
  "environment": "*",
  "entrypoints": {
    "main": [
      "moriz.orangesunshine.OrangeSunshine"
    ],
    "client": [
      "moriz.orangesunshine.client.OrangeSunshineClient"
    ],
    "emi": [
      "moriz.orangesunshine.compat.emi.Main"
    ],
    "modmenu": [
