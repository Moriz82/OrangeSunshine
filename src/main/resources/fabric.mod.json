  },
  "custom": {
    "fabwork": {
      "requiredOn": "*"
    },
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/mt7uwQ4",
        "modmenu.github_releases": "https://github.com/Sollace/orangesunshine/releases"
      }
    }
